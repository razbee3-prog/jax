{
  "name": "jax-pilot",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:env": "node scripts/check-env",
    "dev": "next dev web --hostname 0.0.0.0",
    "build": "next build web",
    "start": "node scripts/start-web.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p agent/tsconfig.json && tsc --noEmit -p evals/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sync:shared": "node scripts/sync-shared.mjs",
    "check:shared": "node scripts/sync-shared.mjs --check",
    "extract:landmarks": "node scripts/extract-landmarks",
    "fixtures:negative": "tsx scripts/generate-negative-fixtures.mts",
    "fixtures:faults": "tsx scripts/generate-fault-fixtures.mts",
    "record:lab": "node scripts/record-lab.mjs",
    "agent:dev": "mda dev agent",
    "agent:deploy": "npm run sync:shared && tsx scripts/sync-agent-instructions.mts && mda deploy agent --context-strategy overwrite --name jax-coach-dedicated --agent-server-type dedicated",
    "smoke:agent": "tsx scripts/smoke-agent.mts",
    "smoke:session": "tsx scripts/smoke-session.mts",
    "evals": "tsx scripts/evals.mts",
    "evals:perception": "tsx scripts/eval-perception.mts",
    "evals:online": "tsx scripts/setup-online-evals.mts"
  },
  "dependencies": {
    "@elevenlabs/react": "1.23.1",
    "@langchain/anthropic": "1.6.6",
    "@langchain/langgraph-sdk": "1.17.0",
    "@mediapipe/tasks-vision": "1.2.3",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "clsx": "2.1.1",
    "deepagents": "1.17.0",
    "langchain": "1.6.6",
    "langsmith": "0.13.1",
    "managed-deepagents": "0.10.5",
    "motion": "14.14.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}

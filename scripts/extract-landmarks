import { chromium } from "playwright";
import { readdir, mkdir, writeFile } from "node:fs/promises";
import path from "node:path";

const folder = path.resolve(process.argv[2] ?? "web/public/videos");
const output = path.resolve(process.argv[3] ?? "evals/fixtures");
const browser = await chromium.launch({ args: ["--use-gl=angle", "--use-angle=swiftshader", "--enable-unsafe-swiftshader"] });
await mkdir(output, { recursive: true });
try {
  const page = await browser.newPage();
  for (const file of (await readdir(folder)).filter(file => file.endsWith(".mp4")).sort()) {
    const exercise = path.basename(file, ".mp4");
    if (!["rdl", "push-press", "curl", "push-up"].includes(exercise)) continue;
    await page.goto((process.env.LAB_URL ?? "http://127.0.0.1:3000") + "/lab");
    await page.getByLabel("Exercise", { exact: true }).selectOption(exercise);
    if (process.env.POSE_DELEGATE === "CPU") await page.getByLabel("Delegate", { exact: true }).selectOption("CPU");
    await page.getByLabel("Upload video", { exact: true }).setInputFiles(path.join(folder, file));
    await page.locator("video").evaluate(video => video.readyState >= 2 ? Promise.resolve() : new Promise(resolve => video.addEventListener("loadeddata", resolve, { once: true })));
    await page.getByRole("button", { name: "Extract fixture" }).click();
    await page.getByRole("status").filter({ hasText: /^Complete$/ }).waitFor({ timeout: 180000 });
    const fixture = JSON.parse(await page.getByLabel("Fixture JSON").inputValue());
    fixture.source = "web/public/videos/" + file;
    fixture.expected = { rdl: 2, "push-press": 2, curl: 3, "push-up": 3 }[exercise];
    await writeFile(path.join(output, exercise + ".json"), JSON.stringify(fixture));
    console.log(exercise + ": " + fixture.frames.length + " frames; expected " + fixture.expected + "; counted " + await page.getByTestId("rep-count").textContent());
  }
} finally { await browser.close(); }
